{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimitPerClient": 300,
    "WindowSeconds": 60,
    "ConcurrencyLimit": 64,
    "QueueLimit": 128
  },
  "ReverseProxy": {
    "Enabled": false,
    "ForwardLimit": 1
  }
}
