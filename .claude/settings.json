{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run lint *)",
      "Bash(npm run test *)",
      "Bash(npm test *)",
      "Bash(npm run build *)",
      "Bash(npm run format *)",
      "Bash(npm run format:check *)",
      "Bash(npm --prefix frontend run check *)",
      "Bash(npm --prefix frontend run typecheck *)",
      "Bash(npm --prefix frontend run lint *)",
      "Bash(npm --prefix frontend run test *)",
      "Bash(npm --prefix frontend test *)",
      "Bash(npm --prefix frontend run build *)",
      "Bash(npm --prefix frontend run format *)",
      "Bash(npm --prefix frontend run format:check *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet format *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet tool restore *)",
      "Bash(dotnet list package *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(~/.microsoft/usersecrets/**)",
      "Bash(dotnet user-secrets list *)",
      "Bash(dotnet user-secrets list)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-changes.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-edited-file.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-changes.mjs",
            "timeout": 420
          }
        ]
      }
    ]
  }
}
