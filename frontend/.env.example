# Fonte de dados do front-end:
#   mock -> dados fictícios em memória (data/courses.seed.json), sem precisar do back-end
#   http -> API .NET (backend/). Em dev e no preview, /api é repassado para http://localhost:5080
VITE_API_MODE=mock

# URL base da API (sem barra no final). Vazio = mesma origem do front-end, que é o recomendado:
# o proxy do Vite (local) e a hospedagem levam /api até a API, sem precisar de CORS.
VITE_API_BASE_URL=

# Latência artificial do modo mock, em milissegundos (para visualizar o carregamento).
VITE_MOCK_LATENCY_MS=600
